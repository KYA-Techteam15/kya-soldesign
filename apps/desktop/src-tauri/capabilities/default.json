{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions minimales de la fenêtre principale : chaque accès est limité à l'usage réel de l'application.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "log:default",
    "window-state:default",
    "process:allow-restart",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://re.jrc.ec.europa.eu/api/*" },
        { "url": "https://geocoding-api.open-meteo.com/*" },
        { "url": "https://customer-geocoding-api.open-meteo.com/*" },
        { "url": "https://api.open-meteo.com/*" },
        { "url": "https://customer-api.open-meteo.com/*" },
        { "url": "https://api.bigdatacloud.net/*" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "mailto:*" }, { "url": "https://*" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPLOG" }, { "path": "$APPLOG/**" }]
    }
  ]
}
